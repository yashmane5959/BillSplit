   GEMINI_API_KEY = "your-gemini-api-key-here"

   # Gmail account that sends the summary
   GMAIL_ADDRESS = "your-sending-address@gmail.com"

   # 16-character App Password from myaccount.google.com/apppasswords
   # (never your real Gmail password)
   GMAIL_APP_PASSWORD = "your-16-char-app-password-here"